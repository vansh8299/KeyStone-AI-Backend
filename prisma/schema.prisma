generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                   String            @id @default(cuid())
  email                String            @unique
  name                 String?
  password             String
  refreshTokenHash     String?
  /// When the current refresh token was issued; lets a just-replaced token be recognised as a
  /// harmless concurrent refresh instead of token theft.
  refreshTokenIssuedAt DateTime?
  /// Set once the user proves they own `email` with a one-time code.
  emailVerified        Boolean           @default(false)
  createdAt            DateTime          @default(now())
  conversations        Conversation[]
  attachments          Attachment[]
  feedback             MessageFeedback[]
  documents            Document[]
  emailOtps            EmailOtp[]
}

enum OtpPurpose {
  VERIFY_EMAIL
  RESET_PASSWORD
}

/// The latest one-time code emailed to a user for a purpose. Only a hash is stored; requesting
/// a new code replaces the old one.
model EmailOtp {
  id        String     @id @default(cuid())
  userId    String
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  purpose   OtpPurpose
  codeHash  String
  attempts  Int        @default(0)
  expiresAt DateTime
  createdAt DateTime   @default(now())

  @@unique([userId, purpose])
}

model Conversation {
  id                      String       @id @default(cuid())
  userId                  String
  user                    User         @relation(fields: [userId], references: [id])
  title                   String?
  activeLeafId            String?
  historySummary          String?      @db.Text
  historySummaryEmbedding Float[]
  historySummaryMessages  Int          @default(0)
  createdAt               DateTime     @default(now())
  updatedAt               DateTime     @updatedAt
  messages                Message[]
  attachments             Attachment[]

  /// Serves "this user's conversations, most recent first" (the paged sidebar, long-term memory).
  @@index([userId, updatedAt(sort: Desc), id(sort: Desc)])
}

model Message {
  id             String           @id @default(cuid())
  conversationId String
  conversation   Conversation     @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  parentId       String?
  parent         Message?         @relation("MessageTree", fields: [parentId], references: [id], onDelete: Cascade)
  children       Message[]        @relation("MessageTree")
  role           MessageRole
  content        String           @db.Text
  source         MessageSource?
  metadata       Json?
  summary        String?          @db.Text
  feedback       MessageFeedback?
  createdAt      DateTime         @default(now())

  @@index([conversationId])
  @@index([parentId])
}

enum MessageRole {
  USER
  ASSISTANT
  SYSTEM
}

enum MessageSource {
  RAG
  WEB_SEARCH
  HYBRID
  NONE
}

model Document {
  id          String         @id @default(cuid())
  userId      String?
  user        User?          @relation(fields: [userId], references: [id], onDelete: Cascade)
  title       String
  sourceUrl   String?
  mongoDocId  String?
  /// SHA-256 of the ingested bytes; used to skip re-ingesting the same content.
  /// Null for documents ingested before duplicate detection existed.
  contentHash String?
  /// Ingestion runs in the background (IngestionJob); only READY documents are searchable.
  status      DocumentStatus @default(READY)
  /// Why ingestion failed (safe to show the user); set when status is FAILED.
  error       String?
  chunkCount  Int?
  /// Which loader produced the chunks: "pdf", "convertible" (converted to PDF) or "structured".
  pipeline    String?
  createdAt   DateTime       @default(now())
  job         IngestionJob?

  @@unique([userId, contentHash])
  @@index([userId])
}

enum DocumentStatus {
  PROCESSING
  READY
  FAILED
}

/// A queued knowledge-base ingestion: the uploaded bytes wait here until a worker processes them.
/// Workers claim jobs with FOR UPDATE SKIP LOCKED and hold a lease (lockedUntil) they renew while
/// working; a job whose worker died becomes claimable again when the lease runs out. The row is
/// deleted once the document is READY or has permanently FAILED.
model IngestionJob {
  id          String    @id @default(cuid())
  documentId  String    @unique
  document    Document  @relation(fields: [documentId], references: [id], onDelete: Cascade)
  userId      String
  filename    String
  sourceUrl   String?
  data        Bytes
  attempts    Int       @default(0)
  /// Not before this time (retry backoff).
  runAfter    DateTime  @default(now())
  lockedUntil DateTime?
  lastError   String?
  createdAt   DateTime  @default(now())

  @@index([runAfter, createdAt])
}

model Attachment {
  id             String            @id @default(cuid())
  userId         String
  user           User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  conversationId String?
  conversation   Conversation?     @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  kind           String            @default("image")
  filename       String
  mimeType       String
  size           Int
  data           Bytes
  parsedText     String            @db.Text
  summary        String?           @db.Text
  pageCount      Int?
  chunks         AttachmentChunk[]
  createdAt      DateTime          @default(now())

  @@index([userId])
  @@index([conversationId])
}

model AttachmentChunk {
  id           String     @id @default(cuid())
  attachmentId String
  attachment   Attachment @relation(fields: [attachmentId], references: [id], onDelete: Cascade)
  index        Int
  location     String?
  text         String     @db.Text
  embedding    Float[]

  @@index([attachmentId])
}

enum FeedbackRating {
  LIKE
  DISLIKE
}

model MessageFeedback {
  id         String         @id @default(cuid())
  messageId  String         @unique
  message    Message        @relation(fields: [messageId], references: [id], onDelete: Cascade)
  userId     String
  user       User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  rating     FeedbackRating
  categories String[]
  reason     String?        @db.Text
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt

  @@index([userId])
  @@index([rating])
}
