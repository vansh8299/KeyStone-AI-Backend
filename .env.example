# Neon Postgres connection string
# Get this from your Neon project dashboard -> Connection Details
# Use the "pooled" connection string for the app, and DIRECT_URL (non-pooled)
# for Prisma Migrate if your Neon project uses PgBouncer pooling.
DATABASE_URL=

# Optional: only needed if using Neon's pooled connection for DATABASE_URL
# DIRECT_URL=

PORT=4000
NODE_ENV=development


# Random strings of 32+ characters, different from each other (required in production), e.g.
# node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
ACCESS_TOKEN_SECRET=
REFRESH_TOKEN_SECRET=
FRONTEND_ORIGIN=http://localhost:3000
# --- Email (one-time codes for sign-up verification and password reset) ---
# A Google Apps Script "mail trigger" sends them from your Gmail over HTTPS (free; works where
# SMTP ports are blocked, e.g. Render's free tier or office networks).
# Leave MAIL_TRIGGER_URL empty in development to print codes to the server console instead.
# Deploy backend/mail-trigger/Code.gs as a web app (see the comment at its top) and paste its URL.
# MAIL_TRIGGER_SECRET must match SECRET in the script; generate one with
# node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
MAIL_TRIGGER_URL=
MAIL_TRIGGER_SECRET=
MAIL_FROM="Keystone AI <no-reply@example.com>"
# Behind a reverse proxy / load balancer: number of proxy hops to trust for client IPs (0 = none)
TRUST_PROXY=0
# Redis, needed to run more than one backend instance: shares rate limits, in-progress chat
# replies and background-work locks. Leave empty for a single instance (state stays in memory).
REDIS_URL=
# On shutdown (SIGTERM), how long to let in-progress work finish (ms). Default 25000 in
# production, 0 in development (so `npm run dev` restarts don't hit "port already in use").
SHUTDOWN_GRACE_MS=
# Knowledge-base ingestion queue: this process runs the workers (set false when a separate
# `npm run worker` service does), how many jobs at once, and how often idle workers check for
# jobs they weren't woken for (ms; long so a serverless database can suspend).
INGESTION_WORKER=true
INGESTION_CONCURRENCY=2
INGESTION_IDLE_POLL_MS=300000
# --- Keep free Render services awake (they spin down after 15 minutes without requests) ---
# Every KEEP_AWAKE_INTERVAL_MS (default 10 min; 0 = off) the backend requests these URLs. Leave
# KEEP_AWAKE_URLS empty to ping only its own /health (Render sets RENDER_EXTERNAL_URL; off locally),
# or list several, comma-separated, e.g. to keep the frontend up too:
# KEEP_AWAKE_URLS=https://your-api.onrender.com/health,https://your-portal.onrender.com/api/health
# Each always-on free service uses ~730 of the workspace's 750 free instance hours a month.
KEEP_AWAKE_URLS=
KEEP_AWAKE_INTERVAL_MS=600000
# Log level: fatal, error, warn, info, debug, trace or silent (default: debug in development,
# info in production). Production logs are JSON, one object per line; development logs are pretty.
LOG_LEVEL=
# --- MongoDB Atlas (vector store) ---
MONGODB_URI=
MONGODB_DB_NAME=rag_chat
MONGODB_COLLECTION=document_chunks
MONGODB_VECTOR_INDEX=vector_index
KB_RELEVANCE_THRESHOLD=0.72
# --- Embeddings: switch provider by changing this one line ---
# "openai" or "gemini"
EMBEDDING_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
GEMINI_API_KEY=
GEMINI_EMBEDDING_MODEL=gemini-embedding-001

# --- Chat generation (used later for the actual answer step) ---
# "openai", "gemini", or "groq"
LLM_PROVIDER=groq
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
OPENAI_CHAT_MODEL=gpt-4o-mini
GEMINI_CHAT_MODEL=gemini-2.0-flash

# --- Web search fallback ---
TAVILY_API_KEY=

# --- LangSmith (tracing + feedback) ---
# Set LANGSMITH_TRACING=true and add an API key from https://smith.langchain.com (Settings -> API Keys).
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=keystone-ai
# Only for self-hosted LangSmith or the EU region (https://eu.api.smith.langchain.com):
# LANGSMITH_ENDPOINT=
